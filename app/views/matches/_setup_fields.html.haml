-# locals: (form:, match:)
%fieldset.my-6.flex.flex-wrap.gap-3.border-0.p-0
  %legend.mb-3.text-sm= t('.opponent')
  %label(class="cursor-pointer rounded border border-line px-4 py-3 has-checked:border-green has-checked:bg-soft-green")
    = form.radio_button(:mode, 'computer', class: 'accent-green', data: { action: 'match-setup#update', match_setup_target: 'mode' })
    = t('.modes.computer')
  %label(class="cursor-pointer rounded border border-line px-4 py-3 has-checked:border-green has-checked:bg-soft-green")
    = form.radio_button(:mode, 'local', class: 'accent-green', data: { action: 'match-setup#update', match_setup_target: 'mode' })
    = t('.modes.local')
.my-5.flex.flex-wrap.items-center.gap-4.text-sm
  = form.label(:strategy, t('.difficulty'))
  = form.select(:strategy, Match::STRATEGIES.map { |value, label| [t("matches.strategies.#{value}"), value] }, { selected: match.strategy || 'hard' }, class: 'min-w-40 rounded border border-line bg-white p-2.5 disabled:bg-muted disabled:text-subtle', data: { match_setup_target: 'strategy' })
%p.my-4.text-sm.text-secondary= t('.starts', mark: 'X')
= form.submit(t('.start_button'), class: 'cursor-pointer rounded border-0 bg-ink px-6 py-3.5 text-white hover:bg-green')
