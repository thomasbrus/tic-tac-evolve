- content_for(:title, t('.title', number: @match.id))
%section(class="mx-auto max-w-[460px]")
  %div
    = Eyebrow(text: t('.eyebrow', number: @match.id.to_s.rjust(3, '0')))
    = Typography(tag: :h1, size: :display, class: 'mt-3 mb-4', role: 'status') do
      = @match.status_label
    = Typography(size: :sm, color: :secondary) do
      = @match.mode_label
  - if @match.errors.any?
    = ErrorMessage(message: @match.errors.full_messages.to_sentence)
  = render('board', match: @match)
  = link_to(t('.new_match'), root_path, class: 'inline-block py-2.5 underline')
